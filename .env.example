# ==============================================================================
# AI Knowledge Assistant - Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars-min
JWT_SECRET_KEY=change-this-jwt-secret-key-to-something-secure-for-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql://postgres:postgres@localhost:5432/knowledge_assistant
# For Docker Compose internal: postgresql://postgres:postgres@db:5432/knowledge_assistant
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_assistant
TEST_DATABASE_URL=sqlite:///./test.db

# Redis & Celery Task Queue
# For local Docker: redis://localhost:6379/0
# For Docker Compose internal: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=knowledge-assistant-docs
S3_REGION=us-east-1
S3_USE_SSL=False

# Local Storage Directory (Used as local fallback when S3 is disabled)
LOCAL_STORAGE_DIR=./storage_data

# AI / OpenAI Configuration
# Provide your OpenAI API key here. If omitted, mock/deterministic embeddings and responses will be used.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG Configuration
RAG_TOP_K_CHUNKS=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_SIZE_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=100
MAX_UPLOAD_SIZE_BYTES=20971520 # 20 MB
